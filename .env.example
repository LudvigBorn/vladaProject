DATABASE_URL="file:./dev.db"

# Secret used to sign admin session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Initial admin account, used by `npm run seed` (only creates the user if none exists yet)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Public site URL, used for metadata/sitemap
SITE_URL="https://vladaproject.kz"
