# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local AI-agent tooling (auto-installed by `prisma init`), not app code
/.agents/
/.claude/
/.windsurf/
skills-lock.json

/src/generated/prisma

# database (DATABASE_URL resolves relative to the process cwd,
# i.e. the project root when running npm scripts from there — not prisma/)
# CMS content lives only in the live database, edited via /admin on the
# actual site — never synced through git, to avoid clobbering live edits.
/dev.db
/dev.db-journal
/prisma/dev.db
/prisma/dev.db-journal
/prod.db
/prod.db-journal
/prisma/prod.db
/prisma/prod.db-journal

# user-uploaded images — live on the server, no need to ship through git
/public/uploads/*
!/public/uploads/.gitkeep
